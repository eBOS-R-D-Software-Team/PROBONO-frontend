<?xml version="1.0" encoding="UTF-8"?>

<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <!-- School frontage detector approximation.
         We only know the two lane ids, not the exact sensor position, so the loops are placed
         near the lane midpoint with friendlyPos enabled. This avoids edge-entry bias better
         than counting whole-network departures or edge touches. -->

    <!-- Cars -->
    <inductionLoop id="school_car_dir_pos" lane="33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="veh_passenger veh_passenger_petrol_be2025 veh_passenger_diesel_be2025 veh_passenger_hybrid_be2025 veh_passenger_electric_be2025 veh_passenger_gas_be2025 veh_passenger_other_be2025" />
    <inductionLoop id="school_car_dir_neg" lane="-33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="veh_passenger veh_passenger_petrol_be2025 veh_passenger_diesel_be2025 veh_passenger_hybrid_be2025 veh_passenger_electric_be2025 veh_passenger_gas_be2025 veh_passenger_other_be2025" />

    <!-- Bikes + motorcycles, because the raw bike total was later split 90/10 -->
    <inductionLoop id="school_bike_dir_pos" lane="33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="bike_bicycle motorcycle_motorcycle" />
    <inductionLoop id="school_bike_dir_neg" lane="-33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="bike_bicycle motorcycle_motorcycle" />

    <!-- Large vehicles -->
    <inductionLoop id="school_large_dir_pos" lane="33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="truck_truck bus_bus pt_bus" />
    <inductionLoop id="school_large_dir_neg" lane="-33128974#0_0" pos="40" period="900" file="school_e1.xml" friendlyPos="true"
        vTypes="truck_truck bus_bus pt_bus" />
</additional>
